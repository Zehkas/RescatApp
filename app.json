{
  "expo": {
    "name": "Rescatapp",
    "slug": "rescatapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rescatapp",
    "userInterfaceStyle": "automatic",
    "ios": {
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "package": "com.anonymous.Rescatapp"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "62db5572-fa6a-4810-8a47-55989a14e3bd"
      }
    },
    "owner": "darktakes-team"
  }
}
